# AI document extraction (Gemini vision) — optional, shows a clear error if unset
# Get a free key at https://aistudio.google.com/apikey
# You can reuse the same key from your other CrewLogic Labs project.
GEMINI_API_KEY=

# Deployed contract address — set after running scripts/deploy.ts
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Optional: a dedicated Sepolia RPC URL for faster/more reliable reads
# (falls back to the public https://rpc.sepolia.org if unset)
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Hardhat deployment only — NOT used by the Next.js app itself.
# Use a fresh, testnet-only wallet. Never reuse a wallet holding real funds.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
